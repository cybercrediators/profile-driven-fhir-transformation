  profile: http://example.org/StructureDefinition/MinimalPatient
}

headers {
  accept: application/fhir+json
  Content-Type: application/fhir+json
}

body:json {
  {
    "resourceType": "Patient",
    "identifier": [
      {
        "value": "1"
      }
    ],
    "name": [
      {
        "family": "Smith",
        "given": [
          "Darcy"
        ]
      }
    ],
    "birthDate": "1970-01-01"
  }
}

body:file {
  file: @file(/home/lutzseba/Desktop/repo/fsh-nifi-bridge/data/testing5.tgz)
