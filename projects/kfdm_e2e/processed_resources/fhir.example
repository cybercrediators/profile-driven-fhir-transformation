dantic_extra__\": null, \"__pydantic_fields_set__\": {\"py/set\": [\"exampleBoolean\", \"description\", \"reference\", \"name\"]}, \"__pydantic_private__\": null}}, {\"py/object\": \"fhir.resources.R4B.implementationguide.ImplementationGuideDefinitionResource\", \"py/state\": {\"__dict__\": {\"fhir_comments\": null, \"extension\": null, \"id\": null, \"modifierExtension\": null, \"description\": null, \"description__ext\": null, \"exampleBoolean\": true, \"exampleBoolean__ext\": null, \"exampleCanonical\": null, \"exampleCanonical__ext\": null, \"fhirVersion\": null, \"fhirVersion__ext\": null, \"groupingId\": null, \"groupingId__ext\": null, \"name\": \"Fragebogen-KFDM-WAVES-beantwortet\", \"name__ext\": null, \"reference\": {\"py/object\": \"fhir.resources.R4B.reference.Reference\", \"py/state\": {\"__dict__\": {\"fhir_comments\": null, \"extension\": null, \"id\": null, \"display\": null, \"display__ext\": null, \"identifier\": null, \"reference\": \"QuestionnaireResponse/Fragebogen-KFDM-WAVES-beantwortet\", \"reference__ext\": null, \"type\": null, \"type__ext\": null}, \"__pydantic_extra__\": null, \"__pydantic_fields_set__\": {\"py/set\": [\"reference\"]}, \"__pydantic_private__\": null}}}, \"__pydantic_extra__\": null, \"__pydantic_fields_set__\": {\"py/set\": [\"exampleBoolean\", \"reference\", \"name\"]}, \"__pydantic_private__\": null}}, {\"py/object\": \"fhir.resources.R4B.implementationguide.ImplementationGuideDefinitionResource\", \"py/state\": {\"__dict__\": {\"fhir_comments\": null, \"extension\": null, \"id\": null, \"modifierExtension\": null, \"description\": \"An example of a bodyweight for the Patient example.\", \"description__ext\": null, \"exampleBoolean\": true, \"exampleBoolean__ext\": null, \"exampleCanonical\": null, \"exampleCanonical__ext\": null, \"fhirVersion\": null, \"fhirVersion__ext\": null, \"groupingId\": null, \"groupingId__ext\": null, \"name\": \"Gewicht\", \"name__ext\": null, \"reference\": {\"py/object\": \"fhir.resources.R4B.reference.Reference\", \"py/state\": {\"__dict__\": {\"fhir_comments\": null, \"extension\": null, \"id\": null, \"display\": null, \"display__ext\": null, \"identifier\": null, \"reference\": \"Observation/Gewicht\", \"reference__ext\": null, \"type\": null, \"type__ext\": null}, \"__pydantic_extra__\": null, \"__pydantic_fields_set__\": {\"py/set\": [\"reference\"]}, \"__pydantic_private__\": null}}}, \"__pydantic_extra__\": null, \"__pydantic_fields_set__\": {\"py/set\": [\"exampleBoolean\", \"description\", \"reference\", \"name\"]}, \"__pydantic_private__\": null}}, {\"py/object\": \"fhir.resources.R4B.implementationguide.ImplementationGuideDefinitionResource\", \"py/state\": {\"__dict__\": {\"fhir_comments\": null, \"extension\": null, \"id\": null, \"modifierExtension\": null, \"description\": \"Sehr geehrte, liebe Patientin, sehr geehrter, lieber Patient,\\nwir freuen uns, dass Sie sich die Zeit zur Teilnahme an dieser Studie mit Fragen zu Ihrer Brustkrebserkrankung nehmen. Sie leisten damit einen wichtigen Beitrag zur Qualit\\u00e4tsverbesserung patientenorientierter Versorgungsstrukturen. Die Inhalte wurden gemeinsam von Vertretern aus Patientenorganisationen, \\u00c4rzte, spezialisierten Pflegekr\\u00e4ften, Psychologen und Spezialisten auf dem Gebiet der Kommunikation erstell.\\nMit Ihren Antworten zu allgemeinen, aber auch speziellen Fragen zu Ihrer Erkrankung, Ihren Erfahrungen im Austausch mit \\u00c4rzten und Pflege sowie Ihren W\\u00fcnschen und Bed\\u00fcrfnissen ist es uns m\\u00f6glich, ein Bild der aktuellen Versorgung zu erheben. Wichtige Erkenntnisse wird auch der Vergleich liefern, wie Pflegekr\\u00e4fte und \\u00c4rzte die Versorgung einsch\\u00e4tzen. Daraus sollen f\\u00fcr die Zukunft gemeinsam erarbeitete L\\u00f6sungsans\\u00e4tze entstehen. \\nDie Befragung richtet sich an Brustkrebs-Erkrankte jedes Stadiums \\u2026 Die Angaben zum Datenschutz haben Sie bereits in der uns r\\u00fcckgesendeten Patienteninformation erhalten \\u2026\\n\\u2026Aus Gr\\u00fcnden der Praktikabilit\\u00e4t und Lesbarkeit wurden alle Fragen zu Geschlechtern in der m\\u00e4nnlichen Form verfasst. Es wird darauf hingewiesen, dass diese auch f\\u00fcr die weibliche und neutrale Form in gleicher Weise gelten.\\nDie Antwortm\\u00f6glichkeiten sind mit der Angabe \\u201eja/nein/unbekannt\\u201c zu beantworten. Teilweise sind Mehrfachantworten m\\u00f6glich oder Sie werden gebeten, die Antwort auf einer Skala von 1=\\u201ctrifft gar nicht zu\\u201c bis 5=\\u201c trifft voll und ganz zu\\u201c zu bewerten, auf die Sie an entsprechender Stelle hingewiesen und weitergeleitet werden.  Bei offenen Antworten werden Sie gebeten, bitte ein Stichwort mit Ihrer h\\u00f6chsten Priorit\\u00e4t zu nennen. Bei Mehrfachnennungen bitte einf\\u00fcgen: keine der Antworten trifft zu.\\nDaten\\n\\nErstgespr\\u00e4ch - Diagnosemitteilung (Erstdiagnose)\\n\\nIn diesem Abschnitt m\\u00f6chten wir gerne mehr \\u00fcber die Rahmenbedingungen Ihrer Gespr\\u00e4che im Rahmen der ersten Diagnosemitteilung erfahren, ihr Erleben dieser Situation (emotional, Eindruck des Arztes) und die Ihnen \\u00fcberlieferte Information.\\n\", \"description__ext\": null, \"exampleBoolean\": false, \"exampleBoolean__ext\": null, \"exampleCanonical\": null, \"exampleCanonical__ext\": null, \"fhirVersion\": null, \"fhirVersion__ext\": null, \"groupingId\": null, \"groupingId__ext\": null, \"name\": \"KFDM WAVES\", \"name__ext\": null, \"reference\": {\"py/object\": \"fhir.resources.R4B.reference.Reference\", \"py/state\": {\"__dict__\": {\"fhir_comments\": null, \"extension\": null, \"id\": null, \"display\": null, \"display__ext\": null, \"identifier\": null, \"reference\": \"Questionnaire/Fragebogen-KFDM-WAVES\", \"reference__ext\": null, \"type\": null, \"type__ext\": null}, \"__pydantic_extra__\": null, \"__pydantic_fields_set__\": {\"py/set\": [\"reference\"]}, \"__pydantic_private__\": null}}}, \"__pydantic_extra__\": null, \"__pydantic_fields_set__\": {\"py/set\": [\"exampleBoolean\", \"description\", \"reference\", \"name\"]}, \"__pydantic_private__\": null}}, {\"py/object\": \"fhir.resources.R4B.implementationguide.ImplementationGuideDefinitionResource\", \"py/state\": {\"__dict__\": {\"fhir_comments\": null, \"extension\": null, \"id\": null, \"modifierExtension\": null, \"description\": \"An example of a bodyheight for the Patient example.\", \"description__ext\": null, \"exampleBoolean\": true, \"exampleBoolean__ext\": null, \"exampleCanonical\": null, \"exampleCanonical__ext\": null, \"fhirVersion\": null, \"fhirVersion__ext\": null, \"groupingId\": null, \"groupingId__ext\": null, \"name\": \"K\\u00f6rpergr\\u00f6\\u00dfe\", \"name__ext\": null, \"reference\": {\"py/object\": \"fhir.resources.R4B.reference.Reference\", \"py/state\": {\"__dict__\": {\"fhir_comments\": null, \"extension\": null, \"id\": null, \"display\": null, \"display__ext\": null, \"identifier\": null, \"reference\": \"Observation/Koerpergroesse\", \"reference__ext\": null, \"type\": null, \"type__ext\": null}, \"__pydantic_extra__\": null, \"__pydantic_fields_set__\": {\"py/set\": [\"reference\"]}, \"__pydantic_private__\": null}}}, \"__pydantic_extra__\": null, \"__pydantic_fields_set__\": {\"py/set\": [\"exampleBoolean\", \"description\", \"reference\", \"name\"]}, \"__pydantic_private__\": null}}, {\"py/object\": \"fhir.resources.R4B.implementationguide.ImplementationGuideDefinitionResource\", \"py/state\": {\"__dict__\": {\"fhir_comments\": null, \"extension\": null, \"id\": null, \"modifierExtension\": null, \"description\": \"A value set for the marital status of the patient.\", \"description__ext\": null, \"exampleBoolean\": false, \"exampleBoolean__ext\": null, \"exampleCanonical\": null, \"exampleCanonical__ext\": null, \"fhirVersion\": null, \"fhirVersion__ext\": null, \"groupingId\": null, \"groupingId__ext\": null, \"name\": \"marital status\", \"name__ext\": null, \"reference\": {\"py/object\": \"fhir.resources.R4B.reference.Reference\"