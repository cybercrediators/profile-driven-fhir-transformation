  "resourceType": "QuestionnaireResponse",
  "id": "Fragebogen-KFDM-WAVES-beantwortet",
  "status": "completed",
  "questionnaire": "http://example.org/Questionnaire/Fragebogen-KFDM-WAVES",
  "item": [
    {
      "linkId": "1",
      "text": "Rahmenbedingungen des Gespräches",
      "item": [
        {
          "linkId": "1.1",
          "text": "Wer hat Sie als Erstes über Ihre Diagnose Brustkrebs aufgklärt?",
          "answer": [
            {
              "valueString": "Frauenarzt einer Klinik"
            }
          ]
        },
        {
          "linkId": "1.2",
          "text": "In wlecher Form wurden Sie über die Diagnose informiert?",
          "answer": [
            {
              "valueString": "Test, ob ich hier alles schreiben kann"
            }
          ]
        },
        {
          "linkId": "1.3",
          "text": "Ist in Ihrer Familie eine Krebserkrankung bekannt?",
          "answer": [
            {
              "valueBoolean": true
            }
          ]
        }
      ]
    },
    {
      "linkId": "2",
      "text": "Erleben während des Gespräches",
      "item": [
        {
          "linkId": "2.1",
          "text": "Was war Ihre erste Reaktion auf den Befund? (Mehrfachnennung möglich)",
          "answer": [
            {
              "valueString": "Ich schaff das, egal wie"
            }
          ]
        },
        {
          "linkId": "2.2",
          "text": "Wie erlebten Sie Ihren Arzt während des Diagnosegesprächs?\n    (1=trifft gar nicht zu, 5=trifft voll und ganz zu)",
          "item": [
            {
              "linkId": "2.2.1",
              "text": "Sachlich:",
              "answer": [
                {
                  "valueCoding": {
                    "code": "4"
                  }
                }
              ]
            },
            {
              "linkId": "2.2.2",
              "text": "Gestresst:",
              "answer": [
                {
                  "valueCoding": {
                    "code": "3"
                  }
                }
              ]
            },
            {
              "linkId": "2.2.3",
              "text": "Besorgt:",
              "answer": [
                {
                  "valueCoding": {
                    "code": "2"
                  }
                }
              ]
            },
            {
              "linkId": "2.2.4",
              "text": "Klar",
              "answer": [
                {
                  "valueCoding": {
                    "code": "5"
                  }
                }
              ]
            },
            {
              "linkId": "2.2.5",
              "text": "Hilfsbereit, unterstützend",
              "answer": [
                {
                  "valueCoding": {
                    "code": "4"
                  }
                }
              ]
            },
            {
              "linkId": "2.2.6",
              "text": "Einfühlsam, mitfühlend",
              "answer": [
                {
                  "valueCoding": {
                    "code": "3"
                  }
                }
              ]
            }
          ]
        },
        {
          "linkId": "2.3",
          "text": "Wie gut haben Sie sich im Allgemeinen aufgeklärt gefühlt bei der Erstdiagnose?",
          "answer": [
            {
              "valueCoding": {
                "code": "1",
                "display": "sehr gut"
              }
            }
          ]
        },
        {
          "linkId": "2.4",
          "text": "Wie lange dauerte das Erstgespräch ungefähr?",
          "answer": [
            {
              "valueCoding": {
                "code": "20min"
              }
            }
          ]
        },
        {
          "linkId": "2.5",
          "text": "Konnte der behandelnde Arzt Ihnen den Befund verständlich erklären?",
          "answer": [
            {
              "valueString": "Ja, ich hatte das Wesentliche verstanden"
            }
          ]
        },
        {
          "linkId": "2.6",
          "text": "Welche Emotionen hatten Sie während des ärztlichen Aufklärungsgesprächs? (Mehrfachnennung möglich)",
          "answer": [
            {
              "valueString": "ich empfand es richtungsweisendd"
            }
          ]
        },
        {
          "linkId": "2.7",
          "text": "Wenn Sie die Befundmitteilung als unverständlich erlebt haben, was hätten Sie sich gewünscht, um den Befund besser zu verstehen? (Mehrfachantworten möglich)",
          "answer": [
            {
              "valueString": "Sonstiges"
            }
          ]
        },
        {
          "linkId": "2.8",
          "text": "Sonstiges bitte hier eintragen:",
          "answer": [
            {
              "valueString": "manchmal etwas freundlicher"
            }
          ]
        },
        {
          "linkId": "2.8",
          "text": "Wie aufnahmefähig waren Sie nach Ihrer eigenen Einschätzung zum Zeitpunkt der Mitteilung der Diagnose und weiteren empfohlenen Schritte auf einer Skala von 0-10",
          "answer": [
            {
              "valueCoding": {
                "code": "9"
              }
            }
          ]
        }
      ]
    }
  ]
}
