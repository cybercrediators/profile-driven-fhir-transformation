{
  "resourceType": "StructureMap",
  "id": "mii-pr-icu-muv-herzfrequenz-map",
  "url": "https://www.medizininformatik-initiative.de/fhir/ext/modul-icu/StructureMap/mii-pr-icu-muv-herzfrequenz-map",
  "name": "mii-pr-icu-muv-herzfrequenzMap",
  "status": "draft",
  "structure": [
    {
      "url": "http://example.org/StructureDefinition/source-definition-testing-kds-icu",
      "mode": "source",
      "alias": "src"
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/Observation",
      "mode": "target",
      "alias": "tgt"
    }
  ],
  "group": [
    {
      "name": "TransformObservation",
      "typeMode": "none",
      "input": [
        {
          "name": "source",
          "type": "Sourcedefinition_testing_kds_icu",
          "mode": "source"
        },
        {
          "name": "target",
          "type": "Observation",
          "mode": "target"
        }
      ],
      "rule": [
        {
          "name": "map-hr-status",
          "source": [
            {
              "context": "source",
              "element": "hrStatus",
              "variable": "vHrStatus",
              "condition": "$this != ''"
            }
          ],
          "target": [
            {
              "context": "target",
              "element": "status",
              "transform": "translate",
              "parameter": [
                {
                  "valueId": "vHrStatus"
                },
                {
                  "valueString": "http://example.org/StructureMap/source-definition-testing-kds-icu/ConceptMap/cm-status-e6034a1f"
                },
                {
                  "valueString": "code"
                }
              ]
            }
          ]
        },
        {
          "name": "map-category-placeholder",
          "source": [
            {
              "context": "source",
              "element": "TODO-findSource",
              "variable": "vCatSrc",
              "condition": "$this != ''"
            }
          ],
          "target": [
            {
              "context": "target",
              "element": "category",
              "variable": "vCategory",
              "transform": "translate",
              "parameter": [
                {
                  "valueId": "vCatSrc"
                },
                {
                  "valueString": "http://example.org/StructureMap/source-definition-testing-kds-icu/ConceptMap/cm-type-a93c8a75"
                },
                {
                  "valueString": "CodeableConcept"
                }
              ]
            }
          ],
          "documentation": "Category mapping source is TODO-findSource; ConceptMap indicates SNOMED system."
        },
        {
          "name": "create-code-structure",
          "source": [
            {
              "context": "source",
              "element": "hrCode",
              "variable": "vHrCode"
            }
          ],
          "target": [
            {
              "context": "target",
              "element": "code",
              "variable": "vCodeObj",
              "transform": "create",
              "parameter": [
                {
                  "valueString": "CodeableConcept"
                }
              ]
            }
          ],
          "rule": [
            {
              "name": "create-coding-in-code",
              "source": [
                {
                  "context": "vHrCode"
                }
              ],
              "target": [
                {
                  "context": "vCodeObj",
                  "element": "coding",
                  "variable": "vCodingObj",
                  "transform": "create",
                  "parameter": [
                    {
                      "valueString": "Coding"
                    }
                  ]
                }
              ],
              "rule": [
                {
                  "name": "set-coding-code",
                  "source": [
                    {
                      "context": "vHrCode"
                    }
                  ],
                  "target": [
                    {
                      "context": "vCodingObj",
                      "element": "code",
                      "transform": "copy",
                      "parameter": [
                        {
                          "valueId": "vHrCode"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "name": "TODO-resolve-effective",
          "source": [
            {
              "context": "source",
              "element": "TODO-findSource"
            }
          ],
          "target": [
            {
              "context": "target",
              "element": "effectiveDateTime",
              "transform": "copy",
              "parameter": [
                {
                  "valueString": "TODO-findSource"
                }
              ]
            }
          ],
          "documentation": "Required field Observation.effective[x] has no source mapping. Placeholder for date/time resolution."
        },
        {
          "name": "TODO-resolve-reference-Observation-subject",
          "source": [
            {
              "context": "source",
              "element": "TODO-findSource"
            }
          ],
          "target": [
            {
              "context": "target",
              "element": "subject",
              "transform": "copy",
              "parameter": [
                {
                  "valueString": "TODO-findSource"
                }
              ]
            }
          ],
          "documentation": "Reference<Observation.subject> → Patient — resolve via bundle assembler"
        }
      ]
    }
  ]
}