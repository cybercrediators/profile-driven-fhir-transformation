              ],
              "target": [
                {
                  "context": "vActExt",
                  "element": "extension",
                  "variable": "vYesNoExt",
                  "transform": "create",
                  "parameter": [
                    {
                      "valueString": "Extension"
                    }
                  ]
                }
              ],
              "rule": [
