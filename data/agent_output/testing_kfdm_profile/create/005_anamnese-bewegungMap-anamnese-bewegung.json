                        {
                          "valueString": "YesNoUnknownExtension"
                        }
                      ]
                    }
                  ]
                },
                {
                  "name": "set-YesNoValue",
                  "source": [
                    {
                      "context": "vBewegung"
                    }
                  ],
                  "target": [
                    {
                      "context": "vYesNoExt",
                      "element": "valueBoolean",
                      "transform": "evaluate",
                      "parameter": [
                        {
                          "valueString": "$this = '1'"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "name": "map-HoursPerWeekExtension",
              "source": [
