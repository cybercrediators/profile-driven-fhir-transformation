        },
        {
          "name": "TODO-resolve-reference-Condition-subject",
          "source": [
            {
              "context": "source"
            }
          ],
          "target": [
            {
              "context": "target",
              "element": "subject",
              "transform": "copy",
              "parameter": [
                {
                  "valueString": "TODO-findSource"
                }
              ]
            }
          ],
          "documentation": "Reference<Condition.subject> → Patient — resolve via bundle assembler"
        }
      ]
