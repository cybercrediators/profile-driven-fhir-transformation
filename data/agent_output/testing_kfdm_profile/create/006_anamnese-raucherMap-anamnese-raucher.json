{
  "resourceType": "StructureMap",
  "id": "anamnese-raucher-map",
  "url": "http://example.org/StructureMap/anamnese-raucher-map",
  "name": "anamnese-raucherMap",
  "status": "draft",
  "structure": [
    {
      "url": "http://example.org/StructureDefinition/source-definition-testing-kfdm-profile",
      "mode": "source",
      "alias": "src"
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/Observation",
      "mode": "target",
      "alias": "tgt"
    }
  ],
  "group": [
    {
      "name": "TransformObservation",
      "typeMode": "none",
      "input": [
        {
          "name": "source",
          "type": "Sourcedefinition_testing_kfdm_profile",
          "mode": "source"
        },
        {
          "name": "target",
          "type": "Observation",
          "mode": "target"
        }
      ],
      "rule": [
        {
          "name": "map-status",
          "source": [
            {
              "context": "source"
            }
          ],
          "target": [
            {
              "context": "target",
              "element": "status",
              "transform": "copy",
              "parameter": [
                {
                  "valueString": "final"
                }
              ]
            }
          ]
        },
        {
          "name": "TODO-SOURCE-FOR-Observation-code",
          "source": [
            {
              "context": "source"
            }
          ],
          "target": [
            {
              "context": "target",
              "element": "code",
              "transform": "copy",
              "parameter": [
                {
                  "valueString": "TODO-findSource"
                }
              ]
            }
          ]
        },
        {
          "name": "map-extension-years",
          "source": [
            {
              "context": "source"
            }
          ],
          "target": [
            {
              "context": "target",
              "element": "extension",
              "variable": "vYearsExt",
              "transform": "create",
              "parameter": [
                {
                  "valueString": "Extension"
                }
              ]
            }
          ],
          "rule": [
            {
              "name": "set-years-extension-url",
              "source": [
                {
                  "context": "source"
                }
              ],
              "target": [
                {
                  "context": "vYearsExt",
                  "element": "url",
                  "transform": "copy",
                  "parameter": [
                    {
                      "valueString": "http://example.org/StructureDefinition/years-of-smoking"
                    }
                  ]
                }
              ]
            },
            {
              "name": "map-years-value",
              "source": [
                {
                  "context": "source",
                  "element": "rauchen_jahre",
                  "variable": "vYears"
                }
              ],
              "target": [
                {
                  "context": "vYearsExt",
                  "element": "valueInteger",
                  "transform": "evaluate",
                  "parameter": [
                    {
                      "valueString": "$this.toInteger()"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}