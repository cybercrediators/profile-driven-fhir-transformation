# Required to use any LLM feature
LLM_MODEL_NAME=
LLM_API_KEY=
LLM_API_BASE_URL=http://localhost:3000/v1

# Optional
REDCAP_API_URL=http://example.org/redcap
REDCAP_API_TOKEN=token

# Optional llm parameters
#
# LLM_BACKEND=openai-compatible
# Name of the variable holding the key, if not LLM_API_KEY.
# LLM_API_KEY_ENV=LLM_API_KEY
# LLM_TEMPERATURE=0.0
# LLM_MAX_OUTPUT_TOKENS=
# LLM_TIMEOUT_S=120
# LLM_SEED=
# json-schema | json-object | prompt
# LLM_STRUCTURED_OUTPUT=json-schema
# LLM_CACHE_ENABLED=true
# Defaults to <project_path>/llm_cache.
# LLM_CACHE_DIR=
# Extra request fields forwarded verbatim, as a JSON object.
# LLM_EXTRA_BODY={"chat_template_kwargs": {"thinking": false}}
# LLM_AUTOMAPPING_TOP_K=5
# LLM_AUTOMAPPING_SECOND_PASS_TOP_K=15
