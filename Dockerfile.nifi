FROM apache/nifi:2.9.0

USER root

# install runtime dependencies for the custom processor
COPY requirements-bridge.txt /tmp/requirements-bridge.txt
RUN apt-get update && apt-get install -y --no-install-recommends python3-pip && \
    rm -rf /var/lib/apt/lists/* && \
    python3 -m pip install --no-cache-dir --break-system-packages -r /tmp/requirements-bridge.txt

COPY src/ /opt/bridge-src/

RUN mkdir -p /opt/nifi/nifi-current/python_extensions

USER nifi

# set correct python PATH
ENV PYTHONPATH=/opt/bridge-src
